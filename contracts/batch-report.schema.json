{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nikitoo0os/cs-editprof/contracts/batch-report.schema.json",
  "title": "CS2 batch render report",
  "type": "object",
  "required": ["schemaVersion", "batchId", "success", "status", "demoPath", "player", "completedAt", "durationMilliseconds", "metrics", "summary", "items", "warnings"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "batchId": { "type": "string", "minLength": 1 },
    "success": { "type": "boolean" },
    "status": { "type": "string" },
    "demoPath": { "type": "string", "minLength": 1 },
    "completedAt": { "type": "string", "format": "date-time" },
    "durationMilliseconds": { "type": "integer", "minimum": 0 },
    "metrics": { "type": "object" },
    "summary": { "type": "object" },
    "items": { "type": "array" },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
