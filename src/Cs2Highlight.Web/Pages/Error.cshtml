@page
@model ErrorModel
@{
  ViewData["Title"] = "Ошибка";
  ViewData["CurrentStep"] = 0;
  UiState errorState = new(
    "alert-triangle",
    "Не удалось выполнить запрос",
    "Обнови страницу или вернись на главную и попробуй ещё раз. Если ошибка повторится, передай код службе поддержки.",
    "Вернуться на главную",
    "/",
    Model.ShowRequestId ? Model.RequestId : null);
}
<partial name="_ErrorState" model="errorState" />
