@page "/generations/{publicId}"
@model GenerationModel
@{
  ViewData["Title"] = "Статус генерации";
  bool completed = Model.Generation.Status is
    GenerationStatus.Completed or GenerationStatus.CompletedWithWarnings;
}
<section class="card"
         data-generation-status
         data-public-id="@Model.Generation.PublicId">
  <h1 id="generation-stage">@Model.Generation.CurrentStage</h1>
  <p>Статус: <strong id="status">@Model.Generation.Status</strong></p>
  <div class="progress" aria-label="Прогресс">
    <div id="bar" style="width:@Model.Generation.ProgressPercent%"></div>
  </div>
  <p><span id="progress-value">@Model.Generation.ProgressPercent</span>%</p>
  <div class="grid">
    <p>Демок: <span id="demo-count">@Model.DemoCount</span></p>
    <p>Игроков: <span id="player-count">@Model.PlayerCount</span></p>
    <p>Моментов: <span id="highlight-count">@Model.HighlightCount</span></p>
  </div>

  <div id="next-action">
    @if (Model.Generation.Status == GenerationStatus.AwaitingPlayerSelection)
    {
      <a class="button"
         asp-page="/Player"
         asp-route-publicId="@Model.Generation.PublicId">Выбрать игрока</a>
    }
    else if (Model.Generation.Status == GenerationStatus.AwaitingHighlightSelection)
    {
      <a class="button"
         asp-page="/Highlights"
         asp-route-publicId="@Model.Generation.PublicId">Выбрать моменты</a>
    }
  </div>

  <div id="video-result" hidden="@(!completed)">
    <h2>Готовое видео</h2>
    <video controls
           preload="metadata"
           src="/generations/@Model.Generation.PublicId/video"></video>
    <p>
      <a class="button"
         href="/generations/@Model.Generation.PublicId/video?download=true">Скачать MP4</a>
    </p>
  </div>

  <p id="generation-error"
     class="error"
     hidden="@(Model.Generation.ErrorCode is null)">
    @if (Model.Generation.ErrorCode is not null)
    {
      <text>@Model.Generation.ErrorCode: @Model.Generation.ErrorMessage</text>
    }
  </p>

  <div id="event-feed" aria-live="polite"></div>

  @if (Model.CanRetry)
  {
    <form method="post" asp-page-handler="Retry" asp-antiforgery="true">
      <button type="submit">Повторить генерацию</button>
    </form>
  }
  @if (Model.Generation.Status is not (
    GenerationStatus.Completed or
    GenerationStatus.CompletedWithWarnings or
    GenerationStatus.Cancelled or
    GenerationStatus.Failed or
    GenerationStatus.Expired))
  {
    <form method="post" asp-page-handler="Cancel" asp-antiforgery="true">
      <button type="submit">Отменить</button>
    </form>
  }
</section>
@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
<script src="/js/generation-status.js"></script>
}
