@page "/generations/{publicId}/highlights"
@model HighlightsModel
@{
  ViewData["Title"] = "Выбор моментов";
  ViewData["CurrentStep"] = 3;
  ViewData["ShowStepper"] = true;
  string[] categories = ["All", "SoloKill", "DoubleKill", "TripleKill", "QuadKill", "Ace", "Recommended"];
  UiState emptyHighlights = new(
    "crosshair",
    "Подходящие моменты не найдены",
    "Попробуй вернуться и выбрать другого игрока или снизить минимальную оценку.",
    "Выбрать игрока",
    $"/generations/{Model.Generation.PublicId}/player");
}
<section data-highlight-catalog
         data-max-selection-count="@Model.MaximumSelectableHighlights"
         data-max-selection-duration="@Model.MaximumSelectionDurationMilliseconds"
         data-transition-duration="@Model.Generation.TransitionDurationMilliseconds">
  <header class="page-header">
    <div>
      <p class="page-eyebrow">Шаг 3 · Моменты</p>
      <h1 class="page-title">Выберите лучшие моменты</h1>
      <p class="page-lead">
        Мы нашли @Model.Cards.Count моментов для @Model.Generation.SelectedPlayerName.
        Выбрано <strong data-selected-count>0</strong> · примерно <strong data-selected-duration>0:00</strong>
      </p>
      @if (Model.MaximumSelectableHighlights.HasValue)
      {
        <p class="muted" data-selection-limit>
          Текущий трек вмещает до <strong>@Model.MaximumSelectableHighlights</strong> моментов
          общей длительностью до
          <strong>@TimeSpan.FromMilliseconds(Model.MaximumSelectionDurationMilliseconds!.Value).ToString(@"m\:ss")</strong>.
        </p>
      }
    </div>
    <button type="button" class="btn btn-secondary" data-select="recommended">
      <img class="ui-icon ui-icon--brand" src="/assets/icons/sparkles.svg" alt="" />
      Выбрать рекомендованные
    </button>
  </header>

  <div asp-validation-summary="All" class="validation-summary-errors" role="alert"></div>

  @if (Model.Cards.Count == 0)
  {
    <partial name="_EmptyState" model="emptyHighlights" />
  }
  else
  {
    <div class="surface surface-pad" style="position:sticky;z-index:20;top:140px">
      <div class="segmented-tabs" role="tablist" aria-label="Категории моментов">
        @foreach (string category in categories)
        {
          int count = category switch
          {
            "All" => Model.Cards.Count,
            "Recommended" => Model.Cards.Count(value => value.Recommended),
            _ => Model.Cards.Count(value => value.Type == category)
          };
          <button type="button"
                  class="segmented-tab"
                  role="tab"
                  aria-selected="@(category == "All" ? "true" : "false")"
                  data-filter="@category">
            @UiText.HighlightTab(category)
            <span class="segmented-tab__count">@count</span>
          </button>
        }
      </div>
      <div class="catalog-toolbar catalog-toolbar__desktop" style="margin:10px 0 0">
        <label style="flex:1">
          <span class="form-label">Поиск</span>
          <input class="form-control"
                 type="search"
                 data-highlight-search
                 placeholder="Карта, файл или тег" />
        </label>
        <label style="min-width:190px">
          <span class="form-label">Матч</span>
          <select class="form-select" id="demo-filter">
            <option value="All">Все матчи</option>
            @foreach (string demo in Model.Cards.Select(value => value.DemoFileName).Distinct().Order())
            {
              <option value="@demo">@demo</option>
            }
          </select>
        </label>
        <label style="min-width:190px">
          <span class="form-label">Сортировка</span>
          <select class="form-select" id="catalog-sort">
            <option value="score">Сначала лучшие</option>
            <option value="round">По раунду</option>
            <option value="chronological">По хронологии</option>
          </select>
        </label>
        <button class="btn btn-secondary mobile-filter-button"
                type="button"
                data-drawer-target="filter-drawer"
                data-drawer-show="filter-drawer"
                aria-controls="filter-drawer">
          <img class="ui-icon" src="/assets/icons/filter.svg" alt="" />
          Фильтры
        </button>
      </div>
    </div>

    <form method="post" asp-antiforgery="true" id="selection-form" data-loading-form>
      <div class="highlight-grid">
        @foreach (HighlightCard card in Model.Cards)
        {
          <partial name="_HighlightCard" model="card" />
        }
      </div>

      <section class="surface surface-pad" style="margin-bottom:24px">
        <span class="badge badge-brand">Видеоэффекты</span>
        <h2 class="section-title" style="margin-top:13px">Выберите характер монтажа</h2>
        <div class="option-grid" style="margin-top:16px">
          <label class="option-card">
            <input asp-for="EffectPreset" type="radio" value="None" />
            <img class="ui-icon" src="/assets/icons/video.svg" alt="" />
            <strong>Без эффектов</strong>
            <small>Только чистая нарезка выбранных моментов.</small>
          </label>
          <label class="option-card">
            <input asp-for="EffectPreset" type="radio" value="Clean" />
            <img class="ui-icon" src="/assets/icons/film.svg" alt="" />
            <strong>Чистый</strong>
            <small>Деликатные переходы и аккуратный цвет.</small>
          </label>
          <label class="option-card">
            <input asp-for="EffectPreset" type="radio" value="Dynamic" />
            <img class="ui-icon ui-icon--brand" src="/assets/icons/wand-sparkles.svg" alt="" />
            <strong>Динамичный</strong>
            <small>Зумы, импакт, вспышки и акценты на убийствах.</small>
          </label>
        </div>
      </section>

      <div class="selection-bar" aria-label="Выбранные моменты">
        <div class="selection-bar__summary">
          <strong><span data-selected-count>0</span> моментов выбрано</strong>
          <span>≈ <span data-selected-duration>0:00</span></span>
        </div>
        <div style="display:flex;gap:8px">
          <button type="button" class="btn btn-ghost" data-select="none">Снять всё</button>
          <button type="submit"
                  class="btn btn-primary btn-lg"
                  data-selection-submit
                  data-loading-label="Сохраняем моменты…"
                  disabled>
            Продолжить
            <img class="ui-icon" src="/assets/icons/chevron-right.svg" alt="" />
          </button>
        </div>
      </div>
    </form>
  }
</section>

@section Scripts {
  <script type="module" src="/js/highlight-catalog.js"></script>
}
