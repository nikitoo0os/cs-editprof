@page "/admin"
@model Cs2Highlight.Web.Pages.Admin.IndexModel
@{ ViewData["Title"] = "Админ-панель"; }
<section class="page-header"><div><p class="page-eyebrow">Только Admin</p><h1 class="page-title">Админ-панель</h1><p class="page-lead">Сводка пользователей, генераций и очереди без прямого редактирования баланса.</p></div></section>
<div class="stats-grid"><article class="surface surface-pad"><span class="subtle">Пользователи</span><strong class="progress-number">@Model.UserCount</strong></article><article class="surface surface-pad"><span class="subtle">Активные генерации</span><strong class="progress-number">@Model.ActiveGenerations</strong></article><article class="surface surface-pad"><span class="subtle">В очереди</span><strong class="progress-number">@Model.QueueCount</strong></article></div>
<section class="surface surface-pad" style="margin-top:18px"><h2 class="section-title">Корректировка токенов</h2><p class="muted">Каждая корректировка требует причины и создаёт запись AdminAdjustment в ledger.</p><div asp-validation-summary="All" class="validation-summary-errors"></div><form method="post" asp-page-handler="Adjust" class="form-stack"><label>Email пользователя<input asp-for="UserEmail" type="email" /></label><label>Количество<input asp-for="Amount" type="number" /></label><label>Причина<textarea asp-for="Reason" rows="3"></textarea></label><button class="btn btn-primary" type="submit">Записать корректировку</button></form>@if(Model.Message is not null){<p role="status">@Model.Message</p>}</section>
