@using Cs2Highlight.Web.Services
@using Cs2Highlight.Web.Domain
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{ ApplicationUser? headerUser = Context.User.Identity?.IsAuthenticated == true ? await UserManager.GetUserAsync(Context.User) : null; }
<header class="app-header">
  <div class="app-container app-header__inner">
    <a class="brand" asp-page="/Index" aria-label="cshighlighter — на главную">
      <span class="brand__mark" aria-hidden="true">CH</span>
      <span class="brand__wordmark">cs<span>highlighter</span></span>
    </a>
    <nav class="app-nav" aria-label="Основная навигация">
      <a class="app-nav__link app-nav__home" asp-page="/Index">
        <img class="ui-icon" src="/assets/icons/gamepad-2.svg" alt="" />
        Главная
      </a>
      @if (Context.User.Identity?.IsAuthenticated == true)
      {
        <a class="app-nav__link" asp-page="/Profile">Профиль</a>
        <form method="post" asp-page="/Account/Logout"><button class="app-nav__link" type="submit">Выйти</button></form>
      }
      else
      {
        <a class="app-nav__link" asp-page="/Account/Login">Войти</a>
      }
      @if (headerUser is not null)
      {
        <a class="price-pill" asp-page="/Purchase" aria-label="Баланс токенов: @headerUser.TokenBalance">
          <img class="ui-icon ui-icon--brand" src="/assets/icons/badge-dollar-sign.svg" alt="" />
          <span>@headerUser.TokenBalance токенов</span>
        </a>
      }
      <button class="app-nav__link app-nav__help" type="button" data-help-modal-open>
        <img class="ui-icon" src="/assets/icons/circle-help.svg" alt="" />
        Помощь
      </button>
    </nav>
  </div>
</header>
