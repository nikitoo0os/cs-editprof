@model UploadDropzoneViewModel
<div data-upload-dropzone
     data-max-files="@Model.MaximumFiles"
     data-max-file-bytes="@Model.MaximumFileSizeBytes">
  <label class="upload-zone" for="demos">
    <input class="upload-zone__input"
           id="demos"
           type="file"
           name="DemoFiles"
           accept=".dem"
           multiple
           required />
    <span>
      <span class="upload-zone__icon" aria-hidden="true">
        <img class="ui-icon ui-icon--brand" src="/assets/icons/upload-cloud.svg" alt="" />
      </span>
      <strong class="section-title" style="display:block">Перетащи сюда файлы .dem</strong>
      <span class="subtle" style="display:block;margin-top:7px">или выбери их на компьютере</span>
      <span class="muted" style="display:block;margin-top:13px;font-size:12px">
        До @Model.MaximumFiles файлов · Максимум @(Model.MaximumFileSizeBytes / 1024 / 1024 / 1024) ГБ на файл
      </span>
    </span>
  </label>
  <div data-file-summary class="muted" style="margin-top:14px" aria-live="polite">
    Файлы ещё не выбраны
  </div>
  <div data-file-list class="file-list"></div>
</div>
