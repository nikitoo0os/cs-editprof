@model IReadOnlyList<Cs2Highlight.Analysis.WeaponSequenceSegment>
<div class="weapon-sequence" aria-label="Последовательность оружия">
  @foreach (Cs2Highlight.Analysis.WeaponSequenceSegment weapon in Model)
  {
    @if (weapon.SwapBefore)
    {
      <span class="swap" aria-label="Смена оружия">
        <span aria-hidden="true">→</span> СМЕНА <span aria-hidden="true">→</span>
      </span>
    }
    <span class="weapon" data-weapon="@weapon.WeaponCode" title="@weapon.DisplayName">
      <img class="weapon__icon" src="@weapon.IconPath" alt="" width="64" height="28" loading="lazy" />
      <span class="weapon__name">@weapon.DisplayName</span>
      @if (weapon.KillCount > 1) { <span class="weapon__count">×@weapon.KillCount</span> }
    </span>
  }
</div>
