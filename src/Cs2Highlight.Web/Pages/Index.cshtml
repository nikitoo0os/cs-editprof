@page
@model IndexModel
@{
  ViewData["Title"] = "Создать CS2-мувик";
  string? friendlyError = Model.Error switch
  {
    "FILE_TOO_LARGE" => "Одна из демок превышает допустимый размер.",
    "TOO_MANY_FILES" => "Выбрано слишком много файлов.",
    "ALL_FILES_DUPLICATE" => "Все выбранные демки уже были добавлены.",
    "TOKEN_BALANCE_INSUFFICIENT" => "Для создания видео нужен один свободный токен. Пополните баланс или дождитесь завершения уже запущенного рендера.",
    "INVALID_MATCH_CODE" => "Проверь формат кода матча CS2.",
    "NO_MATCH_CODES" => "Вставь хотя бы один код матча.",
    "TOO_MANY_MATCH_CODES" => "Слишком много кодов матчей за один импорт.",
    "STEAM_IMPORT_NOT_CONFIGURED" => "Импорт Steam пока не настроен на render-машине.",
    "STEAM_IMPORT_DISABLED" => "Импорт через Steam отключён в настройках.",
    "STEAM_IMPORT_TIMEOUT" => "Steam не ответил вовремя. Повтори импорт через минуту.",
    "STEAM_IMPORT_FAILED" => "Steam не смог получить эту демку. Проверь, что Steam запущен и матч ещё доступен.",
    "STEAM_BOT_NOT_CONFIGURED" => "Серверный Steam-бот ещё не подключён.",
    "STEAM_BOT_AUTH_FAILED" => "Сессия серверного Steam-бота истекла. Администратору нужно повторно подключить аккаунт.",
    "STEAM_BOT_GC_UNAVAILABLE" => "Серверный Steam-бот вошёл в Steam, но CS2 Game Coordinator пока не отвечает.",
    "STEAM_BOT_FAILED" => "Серверный Steam-бот не смог получить replay. Попробуй ещё раз.",
    "MATCH_NOT_FOUND" => "Steam не нашёл матч по этому коду. Возьми код из CS2 → Ваши матчи и попробуй свежий replay.",
    "DEMO_URL_NOT_FOUND" => "Steam вернул матч без ссылки на replay. Попробуй другой код.",
    "STEAM_DOWNLOAD_FAILED" => "Сервер replay у Valve временно не отвечает. Подожди немного и повтори импорт.",
    "DUPLICATE_MATCH_CODES" => "Один и тот же код матча вставлен несколько раз.",
    "DEMO_EXPIRED" => "Эта демка уже удалена с серверов Valve.",
    "ALL_MATCHES_DUPLICATE" => "Все эти демки уже были добавлены в эту генерацию.",
    _ when Model.Error is not null => "Не удалось загрузить демки. Проверь файлы и попробуй ещё раз.",
    _ => null
  };
}
<section class="home-landing section-grid-2">
  <div>
    <p class="page-eyebrow">Автоматический CS2-монтаж</p>
    <h1 class="hero-title text-gradient">Преврати свои лучшие моменты в CS2-мувик</h1>
    <p class="page-lead">
      Загрузи демки, выбери хайлайты и музыку.
      cshighlighter сам соберёт готовое видео в ритм трека.
    </p>
    <ul class="benefit-list" aria-label="Преимущества">
      <li class="benefit">
        <span class="benefit__icon"><img class="ui-icon ui-icon--brand" src="/assets/icons/crosshair.svg" alt="" /></span>
        Автоматический поиск моментов
      </li>
      <li class="benefit">
        <span class="benefit__icon"><img class="ui-icon ui-icon--brand" src="/assets/icons/music-2.svg" alt="" /></span>
        Монтаж в ритм музыки
      </li>
      <li class="benefit">
        <span class="benefit__icon"><img class="ui-icon ui-icon--brand" src="/assets/icons/badge-dollar-sign.svg" alt="" /></span>
       Одно видео за один токен
      </li>
    </ul>
    <div class="hero-sequence" aria-label="Workflow">
      <div class="hero-sequence__header">
        <span>РАБОЧИЙ ПОТОК / 04</span>
        <span>ДЕМКА → МУВИК</span>
      </div>
      <ol class="hero-sequence__track">
        <li class="hero-sequence__item is-active"><span>01</span><strong>ДЕМКИ</strong><small>ввод</small></li>
        <li class="hero-sequence__item"><span>02</span><strong>МОМЕНТЫ</strong><small>выбор</small></li>
        <li class="hero-sequence__item"><span>03</span><strong>МОНТАЖ</strong><small>сборка</small></li>
        <li class="hero-sequence__item"><span>04</span><strong>МУВИК</strong><small>финиш</small></li>
      </ol>
    </div>
    <p style="margin-top:28px">
      <button class="btn btn-secondary" type="button" data-help-modal-open>
        Как это работает
        <img class="ui-icon" src="/assets/icons/chevron-right.svg" alt="" />
      </button>
    </p>
  </div>

  <section id="upload-workspace" class="surface surface--elevated surface-pad">
    <div class="upload-workspace__signal" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>
    <div style="display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:18px">
      <div>
        <span class="console-kicker">ЗОНА ЗАХВАТА / ГОТОВА К ВВОДУ</span>
        <span class="badge badge-brand">Новый мувик</span>
        <h2 class="section-title" style="margin-top:12px">Добавь демки</h2>
      </div>
      <img class="ui-icon ui-icon--brand" src="/assets/icons/files.svg" alt="" style="width:28px;height:28px" />
    </div>
    @if (friendlyError is not null)
    {
      <div class="error-state-inline" role="alert">@friendlyError</div>
    }
    <form method="post"
          enctype="multipart/form-data"
          asp-antiforgery="true"
          asp-page-handler="Upload"
          data-loading-form>
      <partial name="_UploadDropzone"
               model="new UploadDropzoneViewModel(Model.MaximumFiles, Model.MaximumFileSizeBytes)" />
      <div data-upload-progress hidden aria-live="polite" style="margin-top:18px">
        <div style="display:flex;justify-content:space-between;gap:12px;margin-bottom:8px">
          <strong>Загружаем демку</strong>
          <span data-upload-progress-label>0%</span>
        </div>
        <div class="progress-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
          <div class="progress-value" data-upload-progress-bar style="width:0"></div>
        </div>
      </div>
      <button type="submit"
              class="btn btn-primary btn-lg btn-block"
              style="margin-top:18px"
              data-loading-label="Загружаем демки…">
        <img class="ui-icon" src="/assets/icons/wand-sparkles.svg" alt="" />
        Загрузить и найти моменты
      </button>
    </form>
  </section>
</section>

<section class="surface surface-pad" style="margin-top:18px">
  <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px">
    <div>
      <span class="console-kicker">STEAM GAME COORDINATOR / БЫСТРЫЙ ИМПОРТ</span>
      <h2 class="section-title" style="margin-top:10px">Или вставь коды матчей</h2>
      <p class="muted" style="margin:8px 0 0">По одному коду в строке. Replay получает серверный Steam-бот — запускать Steam у себя не нужно.</p>
    </div>
    <img class="ui-icon ui-icon--brand" src="/assets/icons/download.svg" alt="" style="width:28px;height:28px" />
  </div>
  <form method="post" asp-antiforgery="true" asp-page-handler="Import" data-loading-form style="margin-top:18px">
    <textarea asp-for="MatchShareCodes"
              rows="4"
              class="form-input"
              placeholder="CSGO-XXXXX-XXXXX-XXXXX-XXXXX-XXXXX"
              spellcheck="false"
              autocomplete="off"></textarea>
    <button type="submit" class="btn btn-secondary btn-block" style="margin-top:12px" data-loading-label="Запрашиваем демки…">
      <img class="ui-icon" src="/assets/icons/download.svg" alt="" />
      Получить демки из Steam
    </button>
  </form>
  @if (User.Identity?.IsAuthenticated == true)
  {
    <p style="margin:12px 0 0"><a class="btn btn-primary btn-block" asp-page="/SteamHistory">Выбрать из истории Steam</a></p>
  }
  <p class="subtle" style="margin:12px 0 0">Пароль Steam, Steam Guard и cookies сайту не нужны. Коды действуют, пока Valve хранит replay — обычно около месяца.</p>
</section>

<section class="surface surface-pad" style="margin-top:18px">
  <h2 class="section-title">Как работают токены</h2>
  <p class="muted">Один токен создаёт одно видео. Токен списывается автоматически только после того, как готовое видео успешно отрендерено и доступно вам. Если рендер не завершился, токен остаётся на балансе. Готовое видео хранится до 7 дней.</p>
  <p class="muted">Приглашайте друзей и получайте 1 токен за каждого приглашённого пользователя после подтверждения email. <a asp-page="/ReferralRules">Условия реферальной программы</a>.</p>
</section>

@section Scripts {
  <script type="module" src="/js/upload-dropzone.js"></script>
}
