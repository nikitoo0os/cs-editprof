@page "/account/change-password"
@model Cs2Highlight.Web.Pages.Account.ChangePasswordModel
@{ ViewData["Title"] = "Смена пароля"; }
<section class="auth-card surface surface--elevated surface-pad"><h1 class="page-title">Смена пароля</h1><div asp-validation-summary="All" class="validation-summary-errors"></div><form method="post" class="form-stack"><label>Текущий пароль<input asp-for="Input.CurrentPassword" autocomplete="current-password" /></label><label>Новый пароль<input asp-for="Input.NewPassword" autocomplete="new-password" /></label><label>Повторите пароль<input asp-for="Input.ConfirmPassword" autocomplete="new-password" /></label><button class="btn btn-primary" type="submit">Изменить пароль</button></form></section>
