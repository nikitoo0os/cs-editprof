@page "/account/forgot-password"
@model Cs2Highlight.Web.Pages.Account.ForgotPasswordModel
@{ ViewData["Title"] = "Восстановление пароля"; }
<section class="auth-card surface surface--elevated surface-pad"><h1 class="page-title">Восстановление пароля</h1>@if(Model.Sent){<p class="page-lead">Если такой аккаунт существует, письмо с инструкцией отправлено.</p>}else{<div asp-validation-summary="All" class="validation-summary-errors"></div><form method="post" class="form-stack"><label>Email<input asp-for="Input.Email" autocomplete="email" /></label><button class="btn btn-primary" type="submit">Отправить ссылку</button></form>}</section>
