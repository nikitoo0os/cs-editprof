@page "/account/reset-password"
@model Cs2Highlight.Web.Pages.Account.ResetPasswordModel
@{ ViewData["Title"] = "Новый пароль"; }
<section class="auth-card surface surface--elevated surface-pad"><h1 class="page-title">Новый пароль</h1>@if(Model.Completed){<p class="page-lead">Пароль изменён. <a asp-page="/Account/Login">Войти</a></p>}else{<div asp-validation-summary="All" class="validation-summary-errors"></div><form method="post" class="form-stack"><input type="hidden" asp-for="UserId" /><input type="hidden" asp-for="Token" /><label>Новый пароль<input asp-for="Input.Password" autocomplete="new-password" /></label><label>Повторите пароль<input asp-for="Input.ConfirmPassword" autocomplete="new-password" /></label><button class="btn btn-primary" type="submit">Сохранить</button></form>}</section>
