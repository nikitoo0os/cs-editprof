@page "/account/login"
@model Cs2Highlight.Web.Pages.Account.LoginModel
@{ ViewData["Title"] = "Вход"; }
<section class="auth-card surface surface--elevated surface-pad"><p class="page-eyebrow">Ваш аккаунт</p><h1 class="page-title">Вход</h1>
@if (Model.Registered) { <p class="page-lead" role="status">Проверьте email и подтвердите аккаунт перед входом.</p> }<div asp-validation-summary="All" class="validation-summary-errors" role="alert"></div>
<form method="post" class="form-stack"><input type="hidden" asp-for="ReturnUrl" /><label>Email<input asp-for="Input.Email" autocomplete="email" /></label><label>Пароль<input asp-for="Input.Password" autocomplete="current-password" /></label><label class="checkbox-row"><input asp-for="Input.RememberMe" /> Запомнить меня</label><button class="btn btn-primary btn-lg" type="submit">Войти</button></form>
<p class="muted"><a asp-page="/Account/ForgotPassword">Забыли пароль?</a> · <a asp-page="/Account/Register">Регистрация</a></p></section>
