@page "/generations/{publicId}/music"
@model MusicModel
@{
  ViewData["Title"] = "Музыка и стиль";
  ViewData["CurrentStep"] = 4;
  ViewData["ShowStepper"] = true;
}
<section>
  <header class="page-header">
    <div>
      <p class="page-eyebrow">Шаг 4 · Музыка и монтаж</p>
      <h1 class="page-title">Задайте ритм вашему мувику</h1>
      <p class="page-lead">Добавь трек, а затем выбери стиль, интенсивность синхронизации и цвет.</p>
    </div>
    <span class="badge badge-brand">
      <img class="ui-icon ui-icon--brand" src="/assets/icons/music-2.svg" alt="" />
      Монтаж в ритм
    </span>
  </header>

  <div asp-validation-summary="All" class="validation-summary-errors" role="alert"></div>

  @if (Model.ShowHighlightSelectionReturn)
  {
    <section class="surface surface-pad"
             data-highlight-duration-error
             style="margin-bottom:20px;border-color:var(--color-app-danger)">
      <h2 class="section-title">@Model.HighlightSelectionReturnTitle</h2>
      <p class="page-lead" style="margin-top:8px">
        @Model.HighlightSelectionReturnDescription
      </p>
      <form method="post" asp-page-handler="ReturnToHighlights">
        <button type="submit" class="btn btn-secondary">
          Вернуться к выбору моментов
        </button>
      </form>
    </section>
  }

  @if (Model.Generation.Status == GenerationStatus.AwaitingMusicUpload)
  {
    <div class="section-grid-2" data-music-upload>
      <form class="surface surface-pad"
            method="post"
            asp-page-handler="Upload"
            enctype="multipart/form-data"
            data-loading-form>
        <span class="badge badge-brand">Музыкальный файл</span>
        <label class="upload-zone" for="MusicFile" style="min-height:330px;margin-top:16px">
          <input class="upload-zone__input"
                 asp-for="MusicFile"
                 type="file"
                 accept=".mp3,.wav,.flac,.m4a,.aac"
                 required />
          <span>
            <span class="upload-zone__icon">
              <img class="ui-icon ui-icon--brand" src="/assets/icons/headphones.svg" alt="" />
            </span>
            <strong class="section-title" style="display:block">Перетащи сюда трек</strong>
            <span class="subtle" data-music-file-name>MP3, WAV, FLAC, M4A или AAC</span>
            <span class="muted" style="display:block;margin-top:12px;font-size:12px">До 200 МБ</span>
          </span>
        </label>
        <label class="confirmation-row">
          <input asp-for="RightsConfirmed"
                 type="checkbox"
                 required />
          <span class="confirmation-row__text">
            Я подтверждаю, что имею право использовать этот трек в создаваемом видео.
          </span>
        </label>
        <div data-upload-progress hidden aria-live="polite" style="margin-top:18px">
          <div style="display:flex;justify-content:space-between;gap:12px;margin-bottom:8px">
            <strong>Загружаем музыку</strong>
            <span data-upload-progress-label>0%</span>
          </div>
          <div class="progress-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
            <div class="progress-value" data-upload-progress-bar style="width:0"></div>
          </div>
        </div>
        <button type="submit"
                class="btn btn-primary btn-lg btn-block"
                style="margin-top:18px"
                data-loading-label="Анализируем музыку…">
          <img class="ui-icon" src="/assets/icons/wand-sparkles.svg" alt="" />
          Проанализировать музыку
        </button>
      </form>

      <aside class="surface surface--elevated surface-pad">
        <span class="badge badge-violet">Что произойдёт</span>
        <h2 class="section-title" style="margin-top:14px">Найдём сильные музыкальные акценты</h2>
        <p class="page-lead">cshighlighter определит темп, биты и дропы, чтобы ключевые убийства совпали с музыкой.</p>
        <ul class="timeline" style="margin-top:28px">
          <li class="timeline__item is-current"><span class="timeline__dot">1</span><span>Загрузка и проверка трека</span></li>
          <li class="timeline__item"><span class="timeline__dot">2</span><span>Определение темпа и сильных битов</span></li>
          <li class="timeline__item"><span class="timeline__dot">3</span><span>Подготовка вариантов синхронизации</span></li>
        </ul>
      </aside>
    </div>
  }
  else if (Model.Generation.Status == GenerationStatus.AnalyzingMusic)
  {
    <section class="surface surface-pad" aria-busy="true">
      <div class="section-grid-2">
        <div>
          <span class="badge badge-brand">Анализируем трек</span>
          <h2 class="section-title" style="margin-top:14px">Ищем ритм и музыкальные акценты</h2>
          <p class="page-lead">Обычно это занимает меньше минуты. Страница обновится автоматически.</p>
          <div class="progress-track" style="margin-top:24px"><div class="progress-value" style="width:64%"></div></div>
          <p style="margin-top:22px">
            <a class="btn btn-secondary" asp-page="/Generation" asp-route-publicId="@Model.Generation.PublicId">Открыть общий прогресс</a>
          </p>
        </div>
        <div class="waveform" aria-hidden="true">
          @for (int index = 0; index < 34; index++)
          {
            int height = 18 + ((index * 17) % 62);
            <span style="height:@height%"></span>
          }
        </div>
      </div>
    </section>
  }
  else if (Model.Generation.Status == GenerationStatus.AwaitingMovieConfiguration && Model.Music is not null)
  {
    <div data-movie-settings>
      <form class="surface surface-pad"
            method="post"
            asp-page-handler="Configure"
            data-loading-form>
        <section>
          <span class="badge badge-brand">Стиль монтажа</span>
          <h2 class="section-title" style="margin-top:13px">Как должен ощущаться мувик</h2>
          <div class="option-grid" style="margin-top:16px">
            <label class="option-card">
              <input asp-for="MovieStyle" type="radio" value="Clean" />
              <img class="ui-icon" src="/assets/icons/film.svg" alt="" />
              <strong>Чистый</strong>
              <small>Минимум эффектов и фокус на игре.</small>
            </label>
            <label class="option-card">
              <input asp-for="MovieStyle" type="radio" value="CinematicDirector" />
              <img class="ui-icon ui-icon--brand" src="/assets/icons/video.svg" alt="" />
              <strong>Cinematic Director</strong>
              <small>Лучший фрагмент трека, игровые подъезды и убийства на сильных музыкальных пиках.</small>
            </label>
          </div>
        </section>

        <section style="margin-top:30px" data-cinematic-director-settings>
          <span class="badge badge-violet">Cinematic Director</span>
          <h2 class="section-title" style="margin-top:13px">Параметры режиссуры</h2>
          <span class="form-label" style="margin-top:14px">Длительность</span>
          <div class="option-grid" style="margin-top:10px">
            <label class="option-card" style="min-height:92px">
              <input asp-for="CinematicDuration" type="radio" value="Auto" />
              <strong>Auto</strong>
              <small>По highlights и структуре трека.</small>
            </label>
            <label class="option-card" style="min-height:92px">
              <input asp-for="CinematicDuration" type="radio" value="Seconds15" />
              <strong>15 секунд</strong>
            </label>
            <label class="option-card" style="min-height:92px">
              <input asp-for="CinematicDuration" type="radio" value="Seconds30" />
              <strong>30 секунд</strong>
            </label>
            <label class="option-card" style="min-height:92px">
              <input asp-for="CinematicDuration" type="radio" value="Seconds45" />
              <strong>45 секунд</strong>
            </label>
            <label class="option-card" style="min-height:92px">
              <input asp-for="CinematicDuration" type="radio" value="Seconds60" />
              <strong>1 РјРёРЅСѓС‚Р°</strong>
              <small>Р”Р»РёРЅРЅС‹Р№ fragmovie РІ РїСЂРµРґРµР»Р°С… РєРёРЅРµРјР°С‚РёС‡РµСЃРєРѕРіРѕ РєРѕРЅС‚СЂР°РєС‚Р°.</small>
            </label>
          </div>
          <label class="option-card" style="margin-top:14px;min-height:82px">
            <input asp-for="AutomaticCinematicCameras" type="checkbox" />
            <strong>Автоматические кинематографичные ракурсы</strong>
            <small>Система сама добавит пролёты, боковые планы и постановочные камеры между игровыми моментами.</small>
          </label>
          <span class="form-label" style="margin-top:14px">Интенсивность монтажа</span>
          <div class="option-grid" style="margin-top:10px">
            <label class="option-card" style="min-height:82px">
              <input asp-for="CinematicEditIntensity" type="radio" value="Calm" />
              <strong>Спокойная</strong>
            </label>
            <label class="option-card" style="min-height:82px">
              <input asp-for="CinematicEditIntensity" type="radio" value="Balanced" />
              <strong>Сбалансированная</strong>
            </label>
            <label class="option-card" style="min-height:82px">
              <input asp-for="CinematicEditIntensity" type="radio" value="Dynamic" />
              <strong>Динамичная</strong>
            </label>
          </div>
        </section>

        <section style="margin-top:30px">
          <span class="badge">Интенсивность эффектов</span>
          <div class="option-grid" style="margin-top:14px">
            <label class="option-card" style="min-height:110px">
              <input asp-for="EffectIntensity" type="radio" value="Minimal" />
              <strong>Минимальная</strong>
              <small>Плавные зумы и редкие мягкие акценты.</small>
            </label>
            <label class="option-card" style="min-height:110px">
              <input asp-for="EffectIntensity" type="radio" value="Balanced" />
              <strong>Сбалансированная</strong>
              <small>Заметная динамика без потери читаемости.</small>
            </label>
            <label class="option-card" style="min-height:110px">
              <input asp-for="EffectIntensity" type="radio" value="Strong" />
              <strong>Сильная</strong>
              <small>Больше выразительных эффектов в пределах бюджета.</small>
            </label>
          </div>
        </section>

        <details class="surface surface-pad" style="margin-top:24px">
          <summary class="section-title">Расширенные настройки эффектов</summary>
          <p class="muted" style="margin-top:8px">Отключайте только группы эффектов — произвольные FFmpeg-команды не принимаются.</p>
          <div class="option-grid" style="margin-top:16px">
            @{
              (string Value, string Name)[] effectGroups =
              [
                (DynamicEffectGroups.SmoothZooms, "Плавные зумы"),
                (DynamicEffectGroups.PunchZooms, "Ударные зумы"),
                (DynamicEffectGroups.MotionBlur, "Размытие движения"),
                (DynamicEffectGroups.RgbSplit, "RGB split"),
                (DynamicEffectGroups.CameraShake, "Тряска камеры"),
                (DynamicEffectGroups.HitStop, "Hit stop"),
                (DynamicEffectGroups.FrameEcho, "Frame echo"),
                (DynamicEffectGroups.LensDistortion, "Линзовое искажение"),
                (DynamicEffectGroups.DynamicTransitions, "Динамические переходы")
              ];
            }
            @foreach (var group in effectGroups)
            {
              <label class="option-card" style="min-height:72px">
                <input type="checkbox"
                       name="EnabledEffectGroups"
                       value="@group.Value"
                       checked="@(Model.EnabledEffectGroups.Contains(group.Value, StringComparer.Ordinal) ? "checked" : null)" />
                <strong>@group.Name</strong>
              </label>
            }
          </div>
        </details>

        <section style="margin-top:30px">
          <span class="badge">Синхронизация</span>
          <div class="option-grid" style="margin-top:14px">
            <label class="option-card" style="min-height:110px">
              <input asp-for="SyncIntensity" type="radio" value="Soft" />
              <strong>Мягкая</strong>
              <small>Музыка поддерживает монтаж, не меняя темп игры.</small>
            </label>
            <label class="option-card" style="min-height:110px">
              <input asp-for="SyncIntensity" type="radio" value="Expressive" />
              <strong>Выраженная</strong>
              <small>Основные убийства попадают в сильные доли.</small>
            </label>
            <label class="option-card" style="min-height:110px">
              <input asp-for="SyncIntensity" type="radio" value="Aggressive" />
              <strong>Агрессивная</strong>
              <small>Максимум ритмических акцентов и ускорений.</small>
            </label>
          </div>
        </section>

        <section style="margin-top:30px">
          <span class="badge">Цвет</span>
          <div class="option-grid" style="margin-top:14px">
            @{
              (ColorGradePreset Value, string Name, string Colors)[] colors =
              [
                (ColorGradePreset.Natural, "Естественный", "linear-gradient(90deg,#64748b,#93c5fd)"),
                (ColorGradePreset.Competitive, "Соревновательный", "linear-gradient(90deg,#0ea5e9,#22d3ee)"),
                (ColorGradePreset.CinematicCool, "Холодное кино", "linear-gradient(90deg,#312e81,#60a5fa)"),
                (ColorGradePreset.CinematicWarm, "Тёплое кино", "linear-gradient(90deg,#9a3412,#fbbf24)"),
                (ColorGradePreset.HighContrast, "Высокий контраст", "linear-gradient(90deg,#020617,#f8fafc)"),
                (ColorGradePreset.Neon, "Неон", "linear-gradient(90deg,#7c3aed,#22d3ee)")
              ];
            }
            @foreach (var color in colors)
            {
              <label class="option-card" style="min-height:105px">
                <input asp-for="ColorGrade" type="radio" value="@color.Value" />
                <span class="color-swatch" style="background:@color.Colors"></span>
                <strong>@color.Name</strong>
              </label>
            }
          </div>
        </section>

        <section class="section-grid-2" style="margin-top:30px">
          <label>
            <span class="form-label">Игровой звук: <strong data-range-value="GameplayGainPercent">@Model.GameplayGainPercent</strong>%</span>
            <input class="form-range" asp-for="GameplayGainPercent" type="range" min="0" max="100" />
          </label>
          <label>
            <span class="form-label">Музыка: <strong data-range-value="MusicGainPercent">@Model.MusicGainPercent</strong>%</span>
            <input class="form-range" asp-for="MusicGainPercent" type="range" min="0" max="100" />
          </label>
        </section>
        <label style="display:block;margin-top:20px">
          <span class="form-label">Дополнительный цветовой профиль</span>
          <select class="form-select" asp-for="LutAssetKey">
            <option value="">Без дополнительного LUT</option>
            @foreach (string lut in Model.AvailableLuts)
            {
              <option value="@lut">@lut</option>
            }
          </select>
        </label>
        <button type="submit"
                class="btn btn-primary btn-lg"
                style="margin-top:24px"
                data-loading-label="Сохраняем настройки…">
          Начать создание видео
          <img class="ui-icon" src="/assets/icons/chevron-right.svg" alt="" />
        </button>
      </form>

    </div>
  }
</section>

@section Scripts {
  <script type="module" src="/js/music-upload.js"></script>
  <script type="module" src="/js/movie-settings.js"></script>
}
