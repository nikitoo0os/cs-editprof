@page "/generations/{publicId}/checkout"
@model CheckoutModel
@{
  ViewData["Title"] = "Оплата";
  ViewData["CurrentStep"] = 5;
  TimeSpan duration = TimeSpan.FromMilliseconds(Model.Generation.EstimatedDurationMilliseconds);
}
<section>
  <header class="page-header">
    <div>
      <p class="page-eyebrow">Шаг 5 · Проверка заказа</p>
      <h1 class="page-title">Всё готово к генерации</h1>
      <p class="page-lead">Проверь параметры. После тестовой оплаты начнётся запись и финальный монтаж.</p>
    </div>
    <span class="badge badge-warning">Тестовая оплата</span>
  </header>

  <div class="section-grid-sidebar">
    <section class="surface surface-pad">
      <span class="badge badge-brand">Ваш мувик</span>
      <h2 class="section-title" style="margin-top:14px">Параметры генерации</h2>
      <div class="checkout-list" style="margin-top:16px">
        <div class="checkout-row"><span class="muted">Игрок</span><strong>@Model.Generation.SelectedPlayerName</strong></div>
        <div class="checkout-row"><span class="muted">Демки</span><strong>@Model.DemoCount</strong></div>
        <div class="checkout-row"><span class="muted">Моменты</span><strong>@Model.SelectedCount</strong></div>
        <div class="checkout-row">
          <span class="muted">Категории</span>
          <strong style="text-align:right">@string.Join(", ", Model.Categories.Select(UiText.HighlightType))</strong>
        </div>
        <div class="checkout-row"><span class="muted">Длительность</span><strong>≈ @duration.Minutes:@duration.Seconds.ToString("00")</strong></div>
        <div class="checkout-row"><span class="muted">Формат</span><strong>@Model.Generation.Width×@Model.Generation.Height · @Model.Generation.Fps FPS</strong></div>
        <div class="checkout-row"><span class="muted">Эффекты</span><strong>@UiText.Effect(Model.Generation.EffectPreset)</strong></div>
        @if (Model.MovieSettings is not null)
        {
          <div class="checkout-row"><span class="muted">Стиль</span><strong>@UiText.MovieStyle(Model.MovieSettings.MovieStyle)</strong></div>
          <div class="checkout-row" data-effect-summary><span class="muted">Интенсивность</span><strong>@UiText.EffectIntensity(Model.MovieSettings.EffectIntensity)</strong></div>
          @if (Model.MovieSettings.MovieStyle == MovieStyle.CinematicDirector)
          {
            <div class="checkout-row"><span class="muted">Режиссура</span><strong>@UiText.CinematicEditIntensity(Model.MovieSettings.CinematicEditIntensity)</strong></div>
          }
        }
        <div class="checkout-row"><span class="muted">Музыка</span><strong>Проанализирована</strong></div>
      </div>
      @if (Model.CinematicPlan is not null)
      {
        <section class="surface" style="padding:16px;margin-top:20px" data-cinematic-timeline>
          <span class="badge badge-violet">План до оплаты</span>
          <h3 class="section-title" style="margin-top:12px">Cinematic timeline</h3>
          <div class="checkout-list" style="margin-top:12px">
            @foreach (CinematicTimelineItem item in Model.CinematicTimeline)
            {
              <div class="checkout-row">
                <strong>@item.Label</strong>
                <span>@item.DurationSeconds.ToString("0.0") sec</span>
              </div>
            }
          </div>
          <p class="muted" style="margin:14px 0 0">
            Выбрано @Model.CinematicPlan.HighlightMatches.Count сильных музыкальных пика.
            Все основные убийства запланированы в high-energy sections.
          </p>
          @if (Model.CinematicPlan.Segments.All(value => value.Camera.Type == CameraShotType.PlayerPov))
          {
            <p class="muted" style="margin:8px 0 0">
              Cinematic camera пока не подтверждена средой рендера — зафиксирован безопасный POV fallback.
            </p>
          }
        </section>
      }
    </section>

    <aside class="surface surface--elevated surface-pad sticky-panel">
      <span class="badge badge-success">
        <img class="ui-icon" src="/assets/icons/shield-check.svg" alt="" />
        Без скрытых платежей
      </span>
      <h2 class="section-title" style="margin-top:16px">Одна генерация</h2>
      <p class="checkout-total">$1.00</p>
      <ul class="benefit-list" style="margin-top:18px">
        <li class="benefit">✓ Запись всех выбранных моментов</li>
        <li class="benefit">✓ Эффекты, цвет и музыка</li>
        <li class="benefit">✓ Готовый MP4 для скачивания</li>
      </ul>
      @if (Model.MovieSettings is not null)
      {
        <div class="surface" style="padding:14px;margin-top:18px">
          @if (Model.MovieSettings.MovieStyle == MovieStyle.CinematicDirector)
          {
            <strong>Мотивированные эффекты</strong>
            <p class="muted" style="margin:7px 0 0;font-size:12px;line-height:1.55">
              Не более одного заметного эффекта на highlight — только по зафиксированному музыкальному пику или финальному убийству.
            </p>
          }
          else
          {
            <strong>Возможные эффекты</strong>
            <p class="muted" style="margin:7px 0 0;font-size:12px;line-height:1.55">
              Плавные и ударные зумы, лёгкая тряска, короткие цветовые и ритмические акценты.
              Конкретный набор зависит от убийств и музыкальных точек.
            </p>
          }
        </div>
      }
      <form method="post" asp-antiforgery="true" data-loading-form>
        <button type="submit"
                class="btn btn-primary btn-lg btn-block"
                style="margin-top:24px"
                data-loading-label="Открываем оплату…">
          <img class="ui-icon" src="/assets/icons/credit-card.svg" alt="" />
          Оплатить $1
        </button>
      </form>
      <p class="muted" style="margin:14px 0 0;font-size:11px;line-height:1.5">
        Денежные средства не списываются: в текущей сборке используется тестовый платёж.
      </p>
    </aside>
  </div>
</section>
