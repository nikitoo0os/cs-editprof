{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "HttpsRedirection": {
    "Enabled": false
  },
  "ConnectionStrings": {
    "GenerationDb": "Data Source=storage/generations.db"
  },
  "Storage": {
    "Root": "storage/generations"
  },
  "Uploads": {
    "MaximumFilesPerGeneration": 10,
    "MaximumFileSizeBytes": 1073741824,
    "MaximumTotalSizeBytes": 5368709120,
    "MinimumDemoSizeBytes": 1024,
    "MinimumFreeDiskSpaceBytes": 10737418240,
    "AllowedExtensions": [".dem"]
  },
  "MusicUploads": {
    "MaximumFileSizeBytes": 209715200,
    "MinimumDurationSeconds": 15,
    "MaximumDurationSeconds": 600,
    "MinimumFreeDiskSpaceBytes": 2147483648,
    "AllowedExtensions": [".mp3", ".wav", ".flac", ".m4a", ".aac"]
  },
  "Pipeline": {
    "DemoParserPath": "artifacts/demo-parser/demo-parser.exe",
    "RenderAgentPath": "src/Cs2Highlight.RenderAgent/bin/Release/net8.0/render-agent.exe",
    "FfmpegPath": "ffmpeg.exe",
    "FfprobePath": "ffprobe.exe",
    "MusicAnalyzerPath": "artifacts/music-analyzer/music-analyzer.exe",
    "FfmpegTimeoutSeconds": 600,
    "DemoFailurePolicy": "SkipInvalidDemo"
  },
  "Retention": {
    "DraftGenerationHours": 24,
    "UnpaidGenerationHours": 24,
    "CompletedGenerationDays": 7,
    "FailedGenerationDays": 3,
    "CancelledGenerationDays": 3,
    "IntermediateClipHoursAfterCompletion": 24,
    "LogsDays": 14,
    "CleanupIntervalMinutes": 60
  },
  "RecommendedSelection": {
    "MaximumHighlights": 5,
    "MaximumSoloKills": 2,
    "MinimumSoloBeautyScore": 35,
    "MinimumMultikillScore": 20,
    "PreferCategoryDiversity": true
  }
}
